# OpenAI API (for natural language search — uses gpt-4o-mini)
OPENAI_API_KEY=

# Google OAuth (for user-facing auth flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Option B: paste the entire JSON key as a single-line string
GOOGLE_SERVICE_ACCOUNT_KEY=
